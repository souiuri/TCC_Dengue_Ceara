\newcommand{\Caption}[1]{ %
	\begin{Spacing}{1.} %
       	\caption{#1} %
   	\end{Spacing} %
}

\newcommand{\Fonte}[2][\fontename]{ 
	\vspace{2pt}
	\captionsetup{labelsep=colon}
 		\fonte[#1]{#2}
 	\vspace{-2pt}
}

% Cria o comando para fazer notas e anotacoes na figura e na tabela
\newcommand{\Nota}[2][\notaname]{\Fonte[#1]{#2}} 


%Remove as bordas do hyperlinks.
\newcommand{\removerbordasdohyperlink}[1]{%
	\ifthenelse{\equal{#1}{sim}}{%
  		\hypersetup{%
  		    pdfborder = {0 0 0}
  		}
    }
}

% Altera a cor dos hyperlinks do documento
\newcommand{\cordohyperlink}[1]{%
	\ifthenelse{\equal{#1}{sim}}{%
		\hypersetup{%
			colorlinks = true,
			linkcolor = blue
		}
	}
}

